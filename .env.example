# --- GitHub ---
# Personal access token (fine-grained) with repo contents + pull-requests read/write
GITHUB_TOKEN=ghp_xxx
# Secret configured on the GitHub webhook (Settings > Webhooks > Secret)
GITHUB_WEBHOOK_SECRET=change_me
# The repo the demo listens to, "owner/repo"
GITHUB_REPO=your-username/ai-code-review-agent-demo

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-sonnet-5

# --- App ---
# Max diff size (bytes) the agents will process; larger PRs get a comment instead
MAX_DIFF_BYTES=200000
LOG_LEVEL=INFO
# SQLite file backing the run-history dashboard (GET /dashboard)
DB_PATH=runs.db
